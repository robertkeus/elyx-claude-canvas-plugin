export fonts = tokens {display: "Bricolage Grotesque ExtraBold", heading: "Bricolage Grotesque", body: "Inter Tight"}
export weights = tokens {display: "Regular", heading: "Bold", regular: "Regular", medium: "Medium", strong: "SemiBold"}
export size = tokens {display: 92, h2: 58, h3: 22, quote: 28, stat: 48, lead: 20, body: 17, small: 14, label: 14, ui: 13, micro: 11}
export tracking = tokens {display: -4%, h2: -3%, h3: -1%, body: -0.3%, label: 0%}
export leading = tokens {display: 0.98, h2: 1.04, h3: 1.2, body: 1.55, quote: 1.3}
export space = tokens {section: 128px, half: 64px, gutter: 80px, block: 56px, group: 28px, item: 12px}
export radius = tokens {chip: 12px, card: 24px, large: 32px, panel: 36px, pill: 999px}

// Soft colored shadows: a 1–2px ink contact shadow under a wide violet-tinted glow.
export shadow = tokens {
  card: [{drop-shadow: {color: #1E1A3A0A, offset: point(0, 1), blur-radius: 2px}}, {drop-shadow: {color: #6B4EFF14, offset: point(0, 14), blur-radius: 36px}}],
  float: [{drop-shadow: {color: #1E1A3A14, offset: point(0, 2), blur-radius: 6px}}, {drop-shadow: {color: #6B4EFF2E, offset: point(0, 32), blur-radius: 64px}}],
  button: [{drop-shadow: {color: #5236E033, offset: point(0, 2), blur-radius: 4px}}, {drop-shadow: {color: #6B4EFF4D, offset: point(0, 10), blur-radius: 24px}}],
  sticker: [{drop-shadow: {color: #1E1A3A1F, offset: point(0, 3), blur-radius: 6px}}, {drop-shadow: {color: #1E1A3A14, offset: point(0, 12), blur-radius: 24px}}]
}
