// Soft: cream background, a violet accent with pastel helpers, chunky rounded shapes, friendly heavy type.
// For consumer apps, education, health, family and community products.
use "fonts/BricolageGrotesque-800.ttf"
use "fonts/BricolageGrotesque-700.ttf"
use "fonts/InterTight.ttf"

export colors = tokens {
  bg: #FFF8F0,
  surface: #FFFFFF,
  ink: #1E1A3A,
  muted: #66618A,
  faint: #A7A2C2,
  line: #EDE6F4,
  accent: #6B4EFF,
  on-accent: #FFFFFF,
  accent-soft: #ECE7FF,
  peach: #FFB48C,
  mint: #8FE3C4,
  sky: #A3D5FF,
  butter: #FFE07A,
  pink: #FFA3CB,
  deep: #1E1A3A,
  on-deep: #FFF8F0,
  ink-soft: #3D3760,
  accent-deep: #5236E0,
