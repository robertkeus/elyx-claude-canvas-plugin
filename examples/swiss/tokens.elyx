export space = tokens {section: 120px, gutter: 48px, column-gap: 24px, block: 64px, group: 24px, item: 8px}
export radius = tokens {none: 0px}
// 12-column grid: 1440 wide, 48px margins, 24px gaps, 90px columns. cN = the width of N columns plus their inner gaps.
export grid = tokens {c1: 90px, c2: 204px, c3: 318px, c4: 432px, c5: 546px, c6: 660px, c7: 774px, c8: 888px, c9: 1002px, c10: 1116px, c11: 1230px, c12: 1344px}
