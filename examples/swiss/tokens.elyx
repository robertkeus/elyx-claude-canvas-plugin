// Swiss: white, black and one signal red on a strict 12-column grid; hairlines, big numbers, no radius.
// For engineering, data, architecture and products that sell precision.
use "fonts/Archivo-Variable.ttf"
use "fonts/GeistMono-Variable.ttf"

export colors = tokens {
  bg: #FFFFFF,
  surface: #F3F3F1,
  ink: #0B0B0B,
  muted: #6B6B6B,
  faint: #A3A3A3,
  line: #E2E2E0,
  rule: #0B0B0B,
  accent: #FF3B1F,
  on-accent: #FFFFFF,
  deep: #0B0B0B,
  on-deep: #FFFFFF,
  deep-muted: #8C8C8C,
  deep-line: #2E2E2E
}

export fonts = tokens {display: "Archivo", body: "Inter", mono: "Geist Mono"}
export weights = tokens {display: "SemiBold", heading: "SemiBold", regular: "Regular", medium: "Medium", strong: "SemiBold"}
export size = tokens {display-xl: 156, display: 120, h2: 60, h3: 20, quote: 36, stat: 96, lead: 20, body: 16, small: 13, label: 12, mega: 300}
export tracking = tokens {display: -5%, h2: -3.5%, h3: -1%, body: -0.5%, label: 2%}
