// CTA: a light blue-tinted panel, copy and two actions on the left, the product window cropped by the panel edge on the right; borrow the "peek" crop.
// Motion: panel fades in (400ms ease-out); the window slides in from x+48 (700ms, cubic-bezier(.16,1,.3,1)); the go-live card follows at +200ms; buttons deepen shadow on hover (150ms).
import "clean/tokens.elyx" as T
import "clean/parts.elyx" as P

export cta = frame {
  left: 0px,
  top: 0px,
  width: 1440px,
  padding: [T.space.block, T.space.gutter, T.space.section, T.space.gutter],
  fill: T.colors.bg,
  layout: {direction: .column},
  children: [panel]

  panel = frame {
    width: 100%,
    height: 456px,
    padding: [0px, 0px, 0px, 72px],
    corner-radius: T.radius.panel,
    fill: [T.colors.accent-soft, {radial-gradient: {at: point(0%, 0%), radius: [70%, 100%], stops: [stop(0%, opacity(T.colors.bg, 70%)), stop(100%, opacity(T.colors.bg, 0%))]}}],
    border: {color: T.colors.accent-line, width: 1px},
    layout: {direction: .row, align-items: .center, item-gap: 48px},
    children: [copy, peek]

    copy = frame {width: 520px, layout: {direction: .column, item-gap: 32px}, overflow: .visible, children: [words, actions, note]
      words = frame {width: 100%, layout: {direction: .column, item-gap: 16px}, children: [heading, lead]
        heading = text : P.h2 {width: 440px, contents: "Run your next payroll in Tessel"}
        lead = text : P.lead {width: 480px, contents: "Book a 30-minute demo. We map your entities, import last month's payroll and show you both runs side by side."}
      }
      actions = frame {layout: {direction: .row, item-gap: 12px}, overflow: .visible, children: [demo, sales]
        demo = frame : P.primaryButton {arrow {display: .visible}}
        sales = frame : P.button {}
      }
      note = text : P.small {contents: "Setup in 2 weeks · No credit card"}
    }

    // The window bleeds past the panel's right and bottom edges; the panel clips it, so its shadow still fades softly on the left.
    peek = frame {width: 560px, height: 456px, overflow: .visible, children: [window, golive]
      window = frame : P.dashboard {left: 48px, top: 72px}
      golive = frame {left: 0px, top: 216px, width: 252px, padding: 16px, corner-radius: T.radius.card, fill: T.colors.bg, border: {color: T.colors.line, width: 1px}, shadow: T.shadows.float, layout: {direction: .column, item-gap: 12px}, children: [goliveTitle, steps]
        goliveTitle = frame {width: 100%, layout: {direction: .row, align-items: .center, justify-content: .space-between}, children: [goliveName, goliveDate]
          goliveName = text : P.uiStrong {contents: "Your go-live plan"}
          goliveDate = text : P.ui {contents: "14 days"}
        }
        steps = frame {layout: {direction: .column}, children: [week1, week2, live]
          week1 = frame : P.approvalStep {width: 220px, stepText {stepTitle {contents: "Import October payroll"} stepMeta {contents: "Week 1 · 412 people mapped"}}}
          week2 = frame : P.approvalStep {width: 220px, stepText {stepTitle {contents: "Parallel run"} stepMeta {contents: "Week 2 · 0 differences"}}}
          live = frame : P.approvalStep {
            width: 220px,
            rail {node {fill: T.colors.accent-soft, border: {color: T.colors.accent, width: 2px}, nodeGlyph {display: .none}} wire {display: .none}}
            stepText {stepTitle {contents: "First live run"} stepMeta {contents: "Dec 1 · you approve, we file"}}
          }
        }
      }
    }
  }
}
