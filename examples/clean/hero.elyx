// Hero: split layout, headline and work-email capture left, the real product window right with two callouts layered over it; borrow the proof row (rating + faces) under the form.
// Motion: copy rises 16px and fades in (600ms, cubic-bezier(.16,1,.3,1), 100ms stagger); window follows from y+40 at +150ms; callouts scale .96→1 at +450/+570ms (500ms); button hover deepens shadow 150ms.
import "clean/tokens.elyx" as T
import "clean/parts.elyx" as P
import "icons/check.svg" as checkIcon
import "icons/sparkles.svg" as sparklesIcon
import "clean/art/star.svg" as starArt
import "clean/art/forecast-area.svg" as forecastArea
import "clean/art/forecast-line.svg" as forecastLine
import "clean/art/forecast-projection.svg" as forecastProjection

export hero = frame {
  left: 0px,
  top: 0px,
  width: 1440px,
  padding: [48px, 0px, 80px, T.space.gutter],
  fill: [T.colors.bg, {radial-gradient: {at: point(74%, 50%), radius: [42%, 58%], stops: [stop(0%, T.colors.accent-soft), stop(100%, opacity(T.colors.accent-soft, 0%))]}}],
  layout: {direction: .row, align-items: .center, item-gap: 56px},
  children: [copy, stage]

  copy = frame {width: 500px, layout: {direction: .column, item-gap: 40px}, overflow: .visible, children: [intro, signup, proof]
    intro = frame {width: 100%, layout: {direction: .column, item-gap: 24px}, children: [kicker, headline, sub]
      kicker = text : P.eyebrow {contents: "WORKFORCE PLANNING AND PAYROLL"}
      headline = text : P.display {
        width: 100%,
        contents: "Plan every hire. Pay people right.",
        subrange: [{range: [17, 34], fill: T.colors.muted}]
      }
      sub = text : P.lead {width: 460px, contents: "Tessel connects your headcount plan to every payroll run, so finance, HR and managers approve the same numbers before anyone gets paid."}
    }
    signup = frame {layout: {direction: .column, item-gap: 16px}, overflow: .visible, children: [field, perks]
      field = frame {width: 460px, height: 56px, padding: [4px, 4px, 4px, 20px], corner-radius: T.radius.card, fill: T.colors.bg, border: {color: T.colors.line, width: 1px}, shadow: T.shadows.card, layout: {direction: .row, align-items: .center, justify-content: .space-between}, overflow: .visible, children: [placeholder, submit]
        placeholder = text : P.body {contents: "Work email"}
        submit = frame : P.primaryButton {arrow {display: .visible}}
      }
      perks = frame {layout: {direction: .row, item-gap: 20px}, children: [perk1, perk2]
        perk1 = frame : P.checkItem {glyph {fill: T.colors.muted} label {contents: "30-minute tailored demo", fill: T.colors.muted}}
        perk2 = frame : P.checkItem {glyph {fill: T.colors.muted} label {contents: "Parallel run before you switch", fill: T.colors.muted}}
      }
    }
    proof = frame {layout: {direction: .row, align-items: .center, item-gap: 16px}, children: [faces, rating]
      faces = frame {width: 148px, height: 36px, children: [f1, f2, f3, f4, f5]
        f1 = frame : P.avatar {left: 0px, top: 0px, width: 36px, height: 36px, border: {color: T.colors.bg, width: 2px}, initials {contents: "PN"}}
        f2 = frame : P.avatar {left: 28px, top: 0px, width: 36px, height: 36px, border: {color: T.colors.bg, width: 2px}, fill: T.colors.deep, initials {contents: "TB", fill: T.colors.on-deep}}
        f3 = frame : P.avatar {left: 56px, top: 0px, width: 36px, height: 36px, border: {color: T.colors.bg, width: 2px}, fill: T.colors.surface-2, initials {contents: "HO", fill: T.colors.ink}}
        f4 = frame : P.avatar {left: 84px, top: 0px, width: 36px, height: 36px, border: {color: T.colors.bg, width: 2px}, fill: T.colors.accent-line, initials {contents: "MR", fill: T.colors.ink}}
        f5 = frame : P.avatar {left: 112px, top: 0px, width: 36px, height: 36px, border: {color: T.colors.bg, width: 2px}, fill: T.colors.surface, initials {contents: "+2k", fill: T.colors.muted, font-size: T.size.micro}}
      }
      rating = frame {layout: {direction: .column, item-gap: 4px}, children: [stars, ratingText]
        stars = frame {layout: {direction: .row, item-gap: 4px}, children: [s1, s2, s3, s4, s5]
          s1 = asset {width: 14px, height: 14px, contents: starArt, fill: T.colors.ink}
          s2 = asset {width: 14px, height: 14px, contents: starArt, fill: T.colors.ink}
          s3 = asset {width: 14px, height: 14px, contents: starArt, fill: T.colors.ink}
          s4 = asset {width: 14px, height: 14px, contents: starArt, fill: T.colors.ink}
          s5 = asset {width: 14px, height: 14px, contents: starArt, fill: T.colors.ink}
        }
        ratingText = text : P.small {contents: "Rated 4.8/5 by 2,300 HR teams", subrange: [{range: [6, 11], font-style: T.weights.strong, fill: T.colors.ink}]}
      }
    }
  }

  // Freeform stage: the window plus two callouts that break its edges.
  stage = frame {width: 764px, height: 822px, overflow: .visible, children: [window, forecast, toast]
    window = frame : P.dashboard {left: 0px, top: 80px}

    forecast = frame {left: 508px, top: 0px, width: 224px, padding: 16px, corner-radius: T.radius.card, fill: T.colors.bg, border: {color: T.colors.line, width: 1px}, shadow: T.shadows.float, layout: {direction: .column, item-gap: 12px}, children: [fHead, fFigure, fChart, fFoot]
      fHead = frame {width: 100%, layout: {direction: .row, align-items: .center, justify-content: .space-between}, children: [fLabel, fIcon]
        fLabel = text : P.ui {contents: "Q1 2027 payroll forecast"}
        fIcon = asset {width: 14px, height: 14px, contents: sparklesIcon, fill: T.colors.muted}
      }
      fFigure = frame {layout: {direction: .column, item-gap: 8px}, children: [fValue, fTrend]
        fValue = text {contents: "€5.62M", font-family: T.fonts.display, font-style: T.weights.display, font-size: T.size.kpi, letter-spacing: T.tracking.h3, font-features: {tnum: 1}, fill: T.colors.ink}
        fTrend = frame {layout: {direction: .row, align-items: .center, item-gap: 8px}, children: [fDelta, fVs]
          fDelta = frame : P.delta {value {contents: "+4.8%"}}
          fVs = text : P.ui {contents: "vs Q4 2026"}
        }
      }
      fChart = frame {width: 192px, height: 48px, children: [fArea, fLine, fProjection, fToday]
        fArea = asset {left: 0px, top: 0px, width: 192px, height: 48px, contents: forecastArea, fill: {linear-gradient: {angle: 180deg, stops: [stop(0%, opacity(T.colors.accent, 18%)), stop(100%, opacity(T.colors.accent, 0%))]}}}
        fLine = asset {left: 0px, top: 0px, width: 192px, height: 48px, contents: forecastLine, fill: T.colors.accent}
        fProjection = asset {left: 0px, top: 0px, width: 192px, height: 48px, contents: forecastProjection, fill: T.colors.accent}
        fToday = frame {left: 116px, top: 21px, width: 8px, height: 8px, corner-radius: 4px, fill: T.colors.bg, border: {color: T.colors.accent, width: 2px}}
      }
      fFoot = frame {width: 100%, padding: [12px, 0px, 0px, 0px], layout: {direction: .row, justify-content: .space-between}, children: [fHires, fBackfills, fRule]
        fHires = text : P.ui {contents: "6 hires planned"}
        fBackfills = text : P.ui {contents: "2 backfills"}
        fRule = frame {ignore-stack: .true, left: 0px, top: 0px, width: 100%, height: 1px, fill: T.colors.line}
      }
    }

    toast = frame {left: -60px, top: 476px, width: 248px, padding: 16px, corner-radius: T.radius.card, fill: T.colors.bg, border: {color: T.colors.line, width: 1px}, shadow: T.shadows.float, layout: {direction: .row, item-gap: 12px}, children: [tIcon, tText]
      tIcon = frame {width: 32px, height: 32px, corner-radius: T.radius.pill, fill: T.colors.success-soft, layout: {direction: .row, align-items: .center, justify-content: .center}, children: [tCheck]
        tCheck = asset {width: 16px, height: 16px, contents: checkIcon, fill: T.colors.success-ink}
      }
      tText = frame {width: 176px, layout: {direction: .column, item-gap: 4px}, children: [tHead, tBody, tWho]
        tHead = frame {width: 100%, layout: {direction: .row, align-items: .center, justify-content: .space-between}, children: [tTitle, tUndo]
          tTitle = text : P.uiStrong {contents: "Payroll approved", font-size: T.size.small}
          tUndo = text : P.uiStrong {contents: "Undo", font-size: T.size.ui, underline: .single}
        }
        tBody = text : P.ui {width: 100%, line-height: T.leading.body, contents: "148 people in Germany get €668,200 on Nov 28."}
        tWho = text : P.ui {contents: "Amara Okafor, CFO · just now", font-size: T.size.micro}
      }
    }
  }
}
