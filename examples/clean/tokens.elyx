// Clean: white and cool greys, one confident blue, quiet layered shadows, product UI as the hero.
// For B2B SaaS, fintech, HR, operations and dashboards.
use "fonts/InterTight.ttf"

export colors = tokens {
  bg: #FFFFFF,
  surface: #F6F8FB,
  surface-2: #EDF1F6,
  ink: #0E1726,
  muted: #586477,
  faint: #98A2B3,
  line: #E3E8EF,
  accent: #2F5BFF,
  on-accent: #FFFFFF,
  accent-soft: #EAF0FF,
  success: #12A866,
  success-soft: #E3F7EE,
  warning: #F2A516,
  danger: #E5484D,
  deep: #0B1220,
  on-deep: #F6F8FB,
  deep-muted: #8A94A6,
  accent-line: #C9D6FF,
  success-ink: #0B7A4B,
  warning-soft: #FEF3DC,
  warning-ink: #8A5A00,
  danger-soft: #FDECEC,
  danger-ink: #C0262D
}

export fonts = tokens {display: "Inter Tight", body: "Inter"}
export weights = tokens {display: "SemiBold", heading: "SemiBold", regular: "Regular", medium: "Medium", strong: "SemiBold"}
export size = tokens {display: 68, h2: 46, h3: 18, quote: 26, stat: 44, lead: 19, body: 16, small: 14, label: 13, title: 30, kpi: 24, button: 15, ui: 12, micro: 11, logo: 21}
export tracking = tokens {display: -3.5%, h2: -2.5%, h3: -1%, body: -0.5%, label: 0%, caps: 6%}
export leading = tokens {display: 1.04, h2: 1.1, h3: 1.3, body: 1.55}
export space = tokens {section: 120px, gutter: 120px, block: 64px, group: 24px, item: 12px}
export radius = tokens {chip: 6px, card: 12px, panel: 16px, pill: 999px, control: 8px}

// Quiet layered shadows: a 1px contact shadow plus one or two soft ambient layers, all in ink.
export shadows = tokens {
  control: [{drop-shadow: {color: opacity(colors.ink, 6%), offset: point(0, 1), blur-radius: 2px}}],
  card: [{drop-shadow: {color: opacity(colors.ink, 5%), offset: point(0, 1), blur-radius: 2px}}, {drop-shadow: {color: opacity(colors.ink, 8%), offset: point(0, 8), blur-radius: 24px}}],
  float: [{drop-shadow: {color: opacity(colors.ink, 6%), offset: point(0, 1), blur-radius: 2px}}, {drop-shadow: {color: opacity(colors.ink, 10%), offset: point(0, 12), blur-radius: 32px}}, {drop-shadow: {color: opacity(colors.ink, 6%), offset: point(0, 32), blur-radius: 64px, spread: -16px}}],
  window: [{drop-shadow: {color: opacity(colors.ink, 5%), offset: point(0, 1), blur-radius: 2px}}, {drop-shadow: {color: opacity(colors.ink, 8%), offset: point(0, 24), blur-radius: 48px}}, {drop-shadow: {color: opacity(colors.ink, 6%), offset: point(0, 64), blur-radius: 120px, spread: -24px}}],
  focus: [{drop-shadow: {color: opacity(colors.accent, 16%), offset: point(0, 0), blur-radius: 0px, spread: 4px}}]
}
