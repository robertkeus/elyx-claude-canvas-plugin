export mossa = tokens {night: #15133A, dusk: #24216A, haze: #4B4699, lavender: #B4ACFF, moon: #F4E8C1, text: #F1EFFF, muted: #A29ED6}
export haulio = tokens {cobalt: #1E40D8, sky: #DCE4FF, amber: #FFC233, ink: #0B1533, mist: #EEF1FA, muted: #5D6787, paper: #FFFFFF}
export tessel = tokens {teal: #0E6B62, sea: #CDEAE5, sand: #F1EADF, clay: #D9CBB6, ink: #13201E, muted: #5E6B68, paper: #FFFDF9}
