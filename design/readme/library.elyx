import "components/type.elyx" as Text
import "sample/product.elyx" as Sample
import "sample/tokens.elyx" as Tokens

export partsSide = frame : Sidebar.sidebar {
  left: 0px,
  top: 1000px,

  body {
    overrides: [insert(head, after = .nil), insert(buttonRow, after = head), insert(fieldRow, after = buttonRow), insert(tagRow, after = fieldRow), insert(planRow, after = tagRow), insert(statRow, after = planRow), insert(markRow, after = statRow)]
  }

  tabs {
    parts {
      glyph {
        fill[0].color: Colors.colors.accent
      }
    }
  }

  head = frame : Nav.navHead {
    label {
      contents: "Components"
    }

    count {
      contents: "16"
    }
  }

  buttonRow = frame : Nav.navRow {
    glyph {
      contents: componentIcon
    }

    label {
      contents: "button"
    }

    count {
      contents: "4"
    }
  }

  fieldRow = frame : Nav.navRow {
    glyph {
      contents: componentIcon
    }

    label {
      contents: "input"
    }

    count {
      contents: "4"
    }
  }

  tagRow = frame : Nav.navRow {
    glyph {
      contents: componentIcon
    }

    label {
      contents: "badge"
    }

    count {
      contents: "2"
    }
  }

  planRow = frame : Nav.navRow {
    glyph {
      contents: componentIcon
    }

    label {
      contents: "plan"
    }

    count {
      contents: "3"
    }
  }

  statRow = frame : Nav.navRow {
    glyph {
      contents: componentIcon
    }

    label {
      contents: "stat"
    }

    count {
      contents: "2"
    }
  }

  markRow = frame : Nav.navRow {
    glyph {
      contents: componentIcon
    }

    label {
      contents: "mark"
    }

    count {
      contents: "1"
    }
  }
}

// Every component and token, with how widely each one is used.
export library = frame {
  left: 0px,
  top: 0px,
  width: 1280px,
  height: 640px,
  fill: Colors.colors.stage,
  children: [window, palette],

  window = frame {
    left: 56px,
    top: 48px,
    width: 1160px,
    height: Spacing.size.screen-height,
    transform: [0.76, 0, 0, 0, 0.76, 0],
    corner-radius: 16px,
    fill: Colors.colors.surface,
    border: {color: Colors.colors.line-strong, width: 1px},
    layout: {direction: .row},
    shadow: {drop-shadow: {color: #00000024, offset: point(0, 24), blur-radius: 64px}},
    children: [nav, main],

    nav = frame : partsSide {}

    main = frame : Center.center {
      topBar {
        project {
          label {
            contents: "driftwood"
          }
        }
      }

      crumbBar {
        name {
          contents: "Components"
        }
      }

      stage {
        overrides: [insert(page, after = .nil)],

        hud {
          display: .none
        }
      }

      page = frame {
        left: 48px,
        top: 36px,
        width: Spacing.size.page-width,
        layout: {direction: .column, item-gap: 16px},
        children: [head, rule, grid],

        head = frame {
          layout: {direction: .column, item-gap: 3px},
          children: [name, note],

          name = text : Text.pageTitle {
            contents: "Components"
          }

          note = text : Text.body {
            contents: "16 across 6 files",
            fill: Colors.colors.muted
          }
        }

        rule = frame {
          width: 100%,
          height: 1px,
          fill: Colors.colors.line-strong
        }

        grid = frame {
          width: 100%,
          layout: {direction: .row, wrap: .true, item-gap: 21px, line-gap: 21px},
          children: [buttonTile, fieldTile, badgeTile, planTile, statTile, markTile],

        buttonTile = frame : Card.tile {
          well {
            fill[0].color: Tokens.sample.paper,
            overrides: [insert(art, after = .nil)]
          }

          caption {
            line {
              name {
                contents: "button.elyx"
              }
            }

            detail {
              contents: "4 variants, 36 uses"
            }
          }

          art = frame : Sample.button {

          }
        }

        fieldTile = frame : Card.tile {
          well {
            fill[0].color: Tokens.sample.paper,
            overrides: [insert(art, after = .nil)]
          }

          caption {
            line {
              name {
                contents: "input.elyx"
              }
            }

            detail {
              contents: "4 variants, 41 uses"
            }
          }

          art = frame : Sample.input {
            transform: [0.8, 0, 0, 0, 0.8, 0]
          }
        }

        badgeTile = frame : Card.tile {
          well {
            fill[0].color: Tokens.sample.paper,
            overrides: [insert(art, after = .nil)]
          }

          caption {
            line {
              name {
                contents: "badge.elyx"
              }
            }

            detail {
              contents: "2 variants, 12 uses"
            }
          }

          art = frame : Sample.badge {
            transform: [1.3, 0, 0, 0, 1.3, 0]
          }
        }

        planTile = frame : Card.tile {
          well {
            fill[0].color: Tokens.sample.paper,
            overrides: [insert(art, after = .nil)]
          }

          caption {
            line {
              name {
                contents: "plan.elyx"
              }
            }

            detail {
              contents: "3 variants, 6 uses"
            }
          }

          art = frame : Sample.plan {
            transform: [0.66, 0, 0, 0, 0.66, 0]
          }
        }

        statTile = frame : Card.tile {
          well {
            fill[0].color: Tokens.sample.paper,
            overrides: [insert(art, after = .nil)]
          }

          caption {
            line {
              name {
                contents: "stat.elyx"
              }
            }

            detail {
              contents: "2 variants, 18 uses"
            }
          }

          art = frame : Sample.stat {

          }
        }

        markTile = frame : Card.tile {
          well {
            fill[0].color: Tokens.sample.paper,
            overrides: [insert(art, after = .nil)]
          }

          caption {
            line {
              name {
                contents: "mark.elyx"
              }
            }

            detail {
              contents: "1 variant, 24 uses"
            }
          }

          art = frame : Sample.mark {
            transform: [1.5, 0, 0, 0, 1.5, 0]
          }
        }
        }
      }
    }
  }

  palette = frame : Card.sheet {
    left: 862px,
    top: 112px,
    width: 368px,
    layout.item-gap: 10px,
    padding: 16px,
    corner-radius: Radius.radius.xl,
    border: {color: Colors.colors.line-strong, width: 1px},
    shadow: [{drop-shadow: {color: #00000029, offset: point(0, 24), blur-radius: 56px}}, {drop-shadow: {color: #0000000F, offset: point(0, 1), blur-radius: 3px}}],
    overrides: [insert(heading, after = .nil), insert(swatches, after = heading), insert(used, after = swatches)],

    heading = text : Text.heading {
      contents: "Colors",
      font-size: 16
    }

    swatches = frame {
      width: 100%,
      layout: {direction: .row, wrap: .true, item-gap: 10px, line-gap: 10px},
      children: [clayTile, mossTile, skyTile, sunTile, inkTile, sandTile],

      clayTile = frame : Card.swatchTile {
        width: 104px,
        border: {color: Colors.colors.accent, width: 2px},

        chipColor {
          fill[0].color: Tokens.sample.clay,
          height: 52px
        }

        caption {
          name {
            contents: "clay"
          }

          value {
            contents: "#D4633A"
          }
        }
      }

      mossTile = frame : Card.swatchTile {
        width: 104px,

        chipColor {
          fill[0].color: Tokens.sample.moss,
          height: 52px
        }

        caption {
          name {
            contents: "moss"
          }

          value {
            contents: "#4F7A5F"
          }
        }
      }

      skyTile = frame : Card.swatchTile {
        width: 104px,

        chipColor {
          fill[0].color: Tokens.sample.sky,
          height: 52px
        }

        caption {
          name {
            contents: "sky"
          }

          value {
            contents: "#4C7FD9"
          }
        }
      }

      sunTile = frame : Card.swatchTile {
        width: 104px,

        chipColor {
          fill[0].color: Tokens.sample.sun,
          height: 52px
        }

        caption {
          name {
            contents: "sun"
          }

          value {
            contents: "#E8B24A"
          }
        }
      }

      inkTile = frame : Card.swatchTile {
        width: 104px,

        chipColor {
          fill[0].color: Tokens.sample.ink,
          height: 52px
        }

        caption {
          name {
            contents: "ink"
          }

          value {
            contents: "#26221D"
          }
        }
      }

      sandTile = frame : Card.swatchTile {
        width: 104px,

        chipColor {
          fill[0].color: Tokens.sample.sand,
          height: 52px
        }

        caption {
          name {
            contents: "sand"
          }

          value {
            contents: "#F1E9DC"
          }
        }
      }
    }

    used = frame : Panel.pair {
      width: 100%,

      key {
        contents: "colors.clay"
      }

      value {
        contents: "Used by 34 layers"
      }
    }
  }
}
