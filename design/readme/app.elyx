// The sidebar for the sample project. Nothing here comes from a real one.
export side = frame : Sidebar.sidebar {
  left: 0px,
  top: 1000px,

  body {
    overrides: [insert(all, after = .nil), insert(head, after = all), insert(home, after = head), insert(plans, after = home), insert(login, after = plans), insert(dash, after = login)]
  }

  tabs {
    screens {
      fill: Colors.colors.chip,

      label {
        fill[0].color: Colors.colors.ink
      }
    }
  }

  all = frame : Nav.pillRow {
    glyph {
      contents: gridIcon
    }

    label {
      contents: "All screens"
    }

    count {
      contents: "4"
    }
  }

  head = frame : Nav.navHead {
    label {
      contents: "Screens"
    }

    count {
      contents: "4"
    }
  }

  home = frame : Nav.thumbRowActive {
    shot {
      fill: {image: {ref: landingShot}}
    }

    label {
      contents: "Landing"
    }
  }

  plans = frame : Nav.thumbRow {
    shot {
      fill: {image: {ref: pricingShot}}
    }

    label {
      contents: "Pricing"
    }
  }

  login = frame : Nav.thumbRow {
    shot {
      fill: {image: {ref: signInShot}}
    }

    label {
      contents: "Sign in"
    }
  }

  dash = frame : Nav.thumbRow {
    shot {
      fill: {image: {ref: todayShot}}
    }

    label {
      contents: "Today"
    }
  }
}

