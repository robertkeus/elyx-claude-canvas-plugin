}

export landing = frame {
  title: "Landing",
  left: 0px,
  top: 0px,
  width: 420px,
  height: 270px,
  fill: Tokens.sample.paper,
  layout: {direction: .column, item-gap: 0px},
  children: [bar, hero],

  bar = frame {
    width: 100%,
    height: 48px,
    layout: {direction: .row, align-items: .center, item-gap: 16px},
    padding: [0px, 22px],
    children: [brand, spacer, one, two],

    brand = frame : mark {}

    spacer = frame {}

    one = text {
      contents: "Pricing",
      font-size: 11,
      fill: Tokens.sample.soft
    }

    two = text {
      contents: "Sign in",
      font-size: 11,
      fill: Tokens.sample.soft
    }
  }

  hero = frame {
    width: 100%,
    layout: {direction: .row, align-items: .center, item-gap: 18px},
    padding: [20px, 22px],
    children: [copy, picture],

    copy = frame {
      width: 216px,
      layout: {direction: .column, align-items: .start, item-gap: 10px},
      children: [headline, body, cta],

      headline = text {
        width: 100%,
        contents: "Notes that find you again.",
        font-size: 26,
        font-style: "SemiBold",
        letter-spacing: -2%,
        line-height: 1.12,
        fill: Tokens.sample.ink
      }

      body = text {
        width: 100%,
        contents: "Write it down once. Driftwood brings it back when it matters.",
        font-size: 12,
        line-height: 1.4,
        fill: Tokens.sample.soft
      }

      cta = frame : button {}
    }

    picture = frame {
      width: 142px,
      height: 164px,
      corner-radius: 14px,
      fill: {linear-gradient: {angle: 150deg, stops: [stop(0%, Tokens.sample.sun), stop(55%, Tokens.sample.clay), stop(100%, Tokens.sample.moss)]}}
    }
  }
}

