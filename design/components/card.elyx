import "tokens/colors.elyx" as Colors
import "tokens/radius.elyx" as Radius
import "tokens/typography.elyx" as Type
import "components/type.elyx" as Text

// A file in a gallery: a preview in a well, a name and one line of detail.
export tile = frame {
  left: 0px,
  top: 0px,
  width: 250px,
  corner-radius: Radius.radius.lg,
  fill: Colors.colors.surface,
  layout: {direction: .column},
  padding: 8px,
  border: {color: Colors.colors.line-strong, width: 1px},
  children: [well, caption],

  well = frame {
    width: 100%,
    height: 136px,
    corner-radius: Radius.radius.md,
    fill: Colors.colors.well,
    layout: {direction: .row, justify-content: .center, align-items: .center}
  }

  caption = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 2px},
    padding: [10px, 4px, 4px, 4px],
    children: [line, detail],

    line = frame {
      width: 100%,
      layout: {direction: .row, align-items: .center, item-gap: 6px},
      children: [name, spacer, note],

      name = text : Text.label {
        contents: "button.elyx"
      }

      spacer = frame {}

      note = text : Text.meta {
        contents: "",
        font-size: Type.fontSize.xs,
        fill: Colors.colors.positive
      }
    }

    detail = text : Text.meta {
      contents: "4 variants"
    }
  }
}

// A white rounded surface on a page, ruled off by its border.
export sheet = frame {
  left: 280px,
  top: 0px,
  width: 400px,
  corner-radius: Radius.radius.lg,
  fill: Colors.colors.surface,
  layout: {direction: .column},
  border: {color: Colors.colors.line-strong, width: 1px}
}

// A color token on the tokens page.
export swatchTile = frame {
  left: 0px,
  top: 240px,
  width: 122px,
  corner-radius: Radius.radius.lg,
  fill: Colors.colors.surface,
  layout: {direction: .column},
  padding: 5px,
  border: {color: Colors.colors.line-strong, width: 1px},
  children: [chipColor, caption],

  chipColor = frame {
    width: 100%,
    height: 60px,
    corner-radius: Radius.radius.md,
    fill: #D4633A,
    border: {color: #0000000F, width: 1px}
  }

  caption = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 1px},
    padding: [7px, 4px, 4px, 4px],
    children: [name, value],

    name = text : Text.label {
      contents: "clay",
      font-size: Type.fontSize.sm,
      font-style: "Medium"
    }

    value = text : Text.figure {
      contents: "#D4633A",
      font-size: Type.fontSize.xs,
      font-style: "Regular",
      fill: Colors.colors.muted
    }
  }
}

// One number with what it counts, on the overview.
export stat = frame {
  left: 400px,
  top: 240px,
  width: 192px,
  height: 86px,
  corner-radius: Radius.radius.lg,
  fill: Colors.colors.surface,
  layout: {direction: .column, justify-content: .center, item-gap: 3px},
  padding: [0px, 16px],
  border: {color: Colors.colors.line-strong, width: 1px},
  children: [number, label],

  number = text : Text.sectionTitle {
    contents: "23",
    font-size: Type.fontSize.display,
    font-features: {tnum: 1, zero: 1}
  }

  label = text : Text.meta {
    contents: "Screens"
  }
}

// A changed file inside an activity card.
export changeTile = frame {
  left: 620px,
  top: 240px,
  width: 170px,
  layout: {direction: .column, item-gap: 7px},
  children: [shot, name, foot],

  shot = frame {
    width: 100%,
    height: 104px,
    corner-radius: Radius.radius.md,
    fill: Colors.colors.well
  }

  name = text : Text.label {
    contents: "sign-in.elyx",
    font-size: Type.fontSize.sm
  }

  foot = frame {
    width: 100%,
    layout: {direction: .row, align-items: .center},
    children: [detail, spacer, note],

    detail = text : Text.meta {
      contents: "View changes"
    }

    spacer = frame {}

    note = text : Text.meta {
      contents: "New",
      font-size: Type.fontSize.xs,
      fill: Colors.colors.positive
    }
  }
}

// A file in the project grid: its preview, its name, and when it changed.
export fileCard = frame {
  left: 0px,
  top: 400px,
  width: 248px,
  layout: {direction: .column, item-gap: 12px},
  children: [shot, caption],

  shot = frame {
    width: 100%,
    height: 160px,
    corner-radius: Radius.radius.lg,
    fill: Colors.colors.well,
    border: {color: Colors.colors.line-strong, width: 1px}
  }

  caption = frame {
    width: 100%,
    layout: {direction: .row, align-items: .start, item-gap: 8px},
    padding: [0px, 2px],
    children: [names, spacer, badge],

    names = frame {
      layout: {direction: .column, item-gap: 3px},
      children: [name, detail],

      name = text : Text.body {
        contents: "landing.elyx",
        font-style: "Medium",
        fill: Colors.colors.ink
      }

      detail = text : Text.meta {
        contents: "Changed 2h ago"
      }
    }

    spacer = frame {}

    badge = frame {
      height: 20px,
      corner-radius: Radius.radius.xs,
      fill: Colors.colors.chip,
      layout: {direction: .row, align-items: .center},
      padding: [0px, 6px],
      children: label,

      label = text : Text.figure {
        contents: "Updated",
        font-size: Type.fontSize.xs,
        font-style: "Regular",
        fill: Colors.colors.body
      }
    }
  }
}
