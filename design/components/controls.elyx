import "icons/search.svg" as searchIcon
import "icons/chevron-down.svg" as chevronIcon
import "icons/plus.svg" as plusIcon
import "tokens/colors.elyx" as Colors
import "tokens/radius.elyx" as Radius
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Type
import "components/type.elyx" as Text

export iconButton = frame {
  left: 0px,
  top: 0px,
  width: Spacing.size.control,
  height: Spacing.size.control,
  corner-radius: Radius.radius.md,
  layout: {direction: .row, justify-content: .center, align-items: .center},
  children: glyph,

  glyph = asset {
    width: 16px,
    height: 16px,
    contents: searchIcon,
    fill: Colors.colors.muted
  }
}

@variant
export iconButtonSoft = frame : iconButton {
  left: 48px,
  top: 0px,
  fill: Colors.colors.chip
}

@variant
export iconButtonActive = frame : iconButton {
  left: 96px,
  top: 0px,
  fill: Colors.colors.chip,

  glyph {
    fill[0].color: Colors.colors.ink
  }
}

// The grey pill the editor uses for project, file name and context values.
export chip = frame {
  left: 0px,
  top: 48px,
  height: 26px,
  corner-radius: Radius.radius.sm,
  fill: Colors.colors.chip,
  layout: {direction: .row, align-items: .center, item-gap: 6px},
  padding: [0px, 9px],
  children: label,

  label = text : Text.figure {
    contents: "Base",
    fill: Colors.colors.body
  }
}

// Filter pill above a page's content.
export filter = frame {
  left: 80px,
  top: 48px,
  height: 28px,
  corner-radius: Radius.radius.md,
  layout: {direction: .row, align-items: .center, item-gap: 6px},
  padding: [0px, 10px],
  children: label,

  label = text : Text.meta {
    contents: "Filter",
    font-size: Type.fontSize.md,
    font-style: "Medium",
    fill: Colors.colors.muted
  }
}

@variant
export filterActive = frame : filter {
  left: 160px,
  top: 48px,
  fill: Colors.colors.chip,

  label {
    fill[0].color: Colors.colors.ink
  }
}

// A floating pill in the corner of the stage, with its keyboard key.
export stageChip = frame {
  left: 0px,
  top: 96px,
  height: 30px,
  corner-radius: Radius.radius.md,
  fill: Colors.colors.surface,
  border: {color: Colors.colors.line, width: 1px},
  layout: {direction: .row, align-items: .center, item-gap: 8px},
  padding: [0px, 10px],
  shadow: {drop-shadow: {color: #0000000A, offset: point(0, 1), blur-radius: 3px}},
  children: [label, key],

  label = text : Text.figure {
    contents: "8 Screens"
  }

  key = frame {
    width: 18px,
    height: 18px,
    corner-radius: Radius.radius.xs,
    fill: Colors.colors.chip,
    layout: {direction: .row, justify-content: .center, align-items: .center},
    children: letter,

    letter = text : Text.hint {
      contents: "S",
      font-size: Type.fontSize.xs,
      font-style: "Medium",
      fill: Colors.colors.muted
    }
  }
}

// The dashed call to action from the editor's sidebar.
export dashedRow = frame {
  left: 0px,
  top: 144px,
  width: 240px,
  height: Spacing.size.row,
  corner-radius: Radius.radius.md,
  border: {color: Colors.colors.dash, width: 1px, dash: [3px, 3px]},
  layout: {direction: .row, align-items: .center, item-gap: 8px},
  padding: [0px, 10px],
  children: [glyph, label],

  glyph = asset {
    width: 14px,
    height: 14px,
    contents: plusIcon,
    fill: Colors.colors.muted
  }

  label = text : Text.body {
    contents: "New",
    fill: Colors.colors.muted
  }
}

// A text input.
export field = frame {
  left: 0px,
  top: 192px,
  width: 248px,
  height: Spacing.size.control,
  corner-radius: Radius.radius.md,
  fill: Colors.colors.chip,
  layout: {direction: .row, align-items: .center, item-gap: 8px},
  padding: [0px, 10px],
  children: value,

  value = text : Text.body {
    contents: "Value",
    fill: Colors.colors.ink
  }
}

// A value with its token, opened to pick another.
export picker = frame {
  left: 0px,
  top: 240px,
  width: 248px,
  height: Spacing.size.control,
  corner-radius: Radius.radius.md,
  fill: Colors.colors.chip,
  layout: {direction: .row, align-items: .center, item-gap: 8px},
  padding: [0px, 10px],
  children: [swatch, name, spacer, value, chevron],

  swatch = frame {
    width: 16px,
    height: 16px,
    corner-radius: Radius.radius.xs,
    fill: Colors.colors.solid,
    border: {color: Colors.colors.line-strong, width: 1px}
  }

  name = text : Text.figure {
    contents: "colors.ink",
    fill: Colors.colors.ink
  }

  spacer = frame {}

  value = text : Text.figure {
    contents: "",
    font-style: "Regular",
    fill: Colors.colors.muted
  }

  chevron = asset {
    width: 14px,
    height: 14px,
    contents: chevronIcon,
    fill: Colors.colors.faint
  }
}

export toggle = frame {
  left: 0px,
  top: 288px,
  width: 22px,
  height: 13px,
  corner-radius: Radius.radius.full,
  fill: Colors.colors.accent,
  children: knob,

  knob = frame {
    right: 2px,
    top: 2px,
    width: 9px,
    height: 9px,
    corner-radius: Radius.radius.full,
    fill: Colors.colors.on-accent
  }
}

@variant
export toggleOff = frame : toggle {
  left: 48px,
  top: 288px,
  fill: Colors.colors.dash,

  knob {
    left: 2px,
    right: .auto,
    fill[0].color: Colors.colors.surface
  }
}

// Two-way choice, such as where an edit lands.
export segments = frame {
  left: 0px,
  top: 320px,
  width: 248px,
  height: Spacing.size.control,
  corner-radius: Radius.radius.md,
  fill: Colors.colors.chip,
  layout: {direction: .row, align-items: .center, item-gap: 2px},
  padding: 2px,
  children: [first, second],

  first = frame {
    width: 50%,
    height: 100%,
    corner-radius: Radius.radius.sm,
    fill: Colors.colors.surface,
    layout: {direction: .row, justify-content: .center, align-items: .center},
    shadow: {drop-shadow: {color: #0000001A, offset: point(0, 1), blur-radius: 2px}},
    children: label,

    label = text : Text.meta {
      contents: "This screen",
      font-style: "Medium",
      fill: Colors.colors.ink
    }
  }

  second = frame {
    width: 50%,
    height: 100%,
    layout: {direction: .row, justify-content: .center, align-items: .center},
    children: label,

    label = text : Text.meta {
      contents: "Everywhere",
      font-style: "Medium"
    }
  }
}

// The solid button from the editor.
export button = frame {
  left: 0px,
  top: 368px,
  height: Spacing.size.control,
  corner-radius: Radius.radius.md,
  fill: Colors.colors.chip,
  layout: {direction: .row, justify-content: .center, align-items: .center, item-gap: 6px},
  padding: [0px, 12px],
  children: label,

  label = text : Text.label {
    contents: "Button",
    font-style: "Medium",
    fill: Colors.colors.body
  }
}

// Rounded key caps for shortcuts.
export keycap = frame {
  left: 120px,
  top: 368px,
  height: 20px,
  min-width: 20px,
  corner-radius: Radius.radius.xs,
  fill: Colors.colors.surface,
  border: {color: Colors.colors.line-strong, width: 1px},
  layout: {direction: .row, justify-content: .center, align-items: .center},
  padding: [0px, 5px],
  children: label,

  label = text : Text.hint {
    contents: "⌘K",
    font-size: Type.fontSize.xs,
    font-style: "Medium",
    fill: Colors.colors.muted
  }
}

// A hairline between groups in a bar, with even space on both sides.
export divider = frame {
  left: 200px,
  top: 368px,
  width: 17px,
  height: 16px,
  layout: {direction: .row, justify-content: .center},
  children: line,

  line = frame {
    width: 1px,
    height: 100%,
    fill: Colors.colors.line-strong
  }
}
