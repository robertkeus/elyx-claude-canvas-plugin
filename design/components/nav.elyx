import "icons/frame.svg" as frameIcon
import "icons/ellipsis.svg" as ellipsisIcon
import "tokens/colors.elyx" as Colors
import "tokens/radius.elyx" as Radius
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Type
import "components/type.elyx" as Text

// Section title in the sidebar, with a count or a menu on the right.
// The space above sets one group off from the last; drop it on a list's first head.
export navHead = frame {
  left: 0px,
  top: 0px,
  width: 248px,
  height: 36px,
  layout: {direction: .row, align-items: .center, item-gap: 6px},
  padding: [10px, 8px, 0px, 8px],
  children: [label, spacer, count],

  label = text : Text.label {
    contents: "Section"
  }

  spacer = frame {}

  count = text : Text.figure {
    contents: "12",
    font-style: "Regular",
    fill: Colors.colors.muted
  }
}

export navRow = frame {
  left: 0px,
  top: 40px,
  width: 248px,
  height: Spacing.size.row,
  corner-radius: Radius.radius.sm,
  layout: {direction: .row, align-items: .center, item-gap: 9px},
  padding: [0px, 8px],
  children: [glyph, label, spacer, count],

  glyph = asset {
    width: 15px,
    height: 15px,
    contents: frameIcon,
    fill: Colors.colors.muted
  }

  label = text : Text.body {
    contents: "Row"
  }

  spacer = frame {}

  count = text : Text.figure {
    contents: "",
    font-style: "Regular",
    fill: Colors.colors.muted
  }
}

@variant
export navRowActive = frame : navRow {
  left: 280px,
  top: 40px,
  fill: Colors.colors.chip,

  glyph {
    fill[0].color: Colors.colors.ink
  }

  label {
    font-style: "Medium",
    fill[0].color: Colors.colors.ink
  }

  count {
    fill[0].color: Colors.colors.muted
  }
}

// A sidebar row with a live thumbnail, so screens are recognised by sight.
export thumbRow = frame {
  left: 0px,
  top: 88px,
  width: 248px,
  height: Spacing.size.row,
  corner-radius: Radius.radius.sm,
  layout: {direction: .row, align-items: .center, item-gap: 9px},
  padding: [0px, 8px],
  children: [shot, label],

  shot = frame {
    width: 22px,
    height: 15px,
    corner-radius: Radius.radius.xs,
    fill: Colors.colors.well,
    border: {color: Colors.colors.line, width: 1px}
  }

  label = text : Text.body {
    contents: "Screen"
  }
}

@variant
export thumbRowActive = frame : thumbRow {
  left: 280px,
  top: 88px,
  fill: Colors.colors.chip,

  shot {
    border[0].color: Colors.colors.line-strong
  }

  label {
    font-style: "Medium",
    fill[0].color: Colors.colors.ink
  }
}

// The row for everything in a view, above its groups. Set the open one on a chip.
export pillRow = frame {
  left: 0px,
  top: 136px,
  width: 248px,
  height: Spacing.size.row,
  corner-radius: Radius.radius.sm,
  layout: {direction: .row, align-items: .center, item-gap: 9px},
  padding: [0px, 8px],
  children: [glyph, label, spacer, count],

  glyph = asset {
    width: 15px,
    height: 15px,
    contents: frameIcon,
    fill: Colors.colors.ink
  }

  label = text : Text.body {
    contents: "Action",
    font-style: "Medium",
    fill: Colors.colors.ink
  }

  spacer = frame {}

  count = text : Text.figure {
    contents: "",
    font-style: "Regular",
    fill: Colors.colors.muted
  }
}

// A text tab at the top of a panel.
export tab = frame {
  left: 0px,
  top: 184px,
  height: 28px,
  corner-radius: Radius.radius.md,
  layout: {direction: .row, align-items: .center},
  padding: [0px, 5px],
  children: label,

  label = text : Text.meta {
    contents: "Tab",
    font-style: "Medium"
  }
}

// The open tab sits on a grey chip.
@variant
export tabActive = frame : tab {
  left: 80px,
  top: 184px,
  fill: Colors.colors.chip,

  label {
    fill[0].color: Colors.colors.ink
  }
}

export tabDivider = frame {
  left: 160px,
  top: 194px,
  width: 1px,
  height: 16px,
  fill: Colors.colors.line
}

export menuButton = frame {
  left: 200px,
  top: 188px,
  width: 22px,
  height: 22px,
  layout: {direction: .row, justify-content: .center, align-items: .center},
  children: glyph,

  glyph = asset {
    width: 15px,
    height: 15px,
    contents: ellipsisIcon,
    fill: Colors.colors.muted
  }
}

// A token group in the sidebar, previewed by its first colors.
export dotsRow = frame {
  left: 0px,
  top: 232px,
  width: 248px,
  height: Spacing.size.row,
  corner-radius: Radius.radius.sm,
  layout: {direction: .row, align-items: .center, item-gap: 3px},
  padding: [0px, 8px],
  children: [label, spacer, one, two, three, four],

  label = text : Text.body {
    contents: "Surfaces"
  }

  spacer = frame {}

  one = frame {
    width: 13px,
    height: 13px,
    corner-radius: Radius.radius.full,
    fill: #FBF7F0,
    border: {color: #0000001A, width: 1px}
  }

  two = frame {
    width: 13px,
    height: 13px,
    corner-radius: Radius.radius.full,
    fill: #F1E9DC,
    border: {color: #0000001A, width: 1px}
  }

  three = frame {
    width: 13px,
    height: 13px,
    corner-radius: Radius.radius.full,
    fill: #FFFFFF,
    border: {color: #0000001A, width: 1px}
  }

  four = frame {
    width: 13px,
    height: 13px,
    corner-radius: Radius.radius.full,
    fill: #E6DDCF,
    border: {color: #0000001A, width: 1px}
  }
}
