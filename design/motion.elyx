    fill: {linear-gradient: {angle: 160deg, stops: [stop(0%, Tokens.sample.clay), stop(100%, Tokens.sample.ink)]}},
    meta: {transition: "dissolve", duration: "motion.slow", easing: "easing.standard"},
    connections: {target: ::photoOne, label: "Next photo"},
  }

  caption = text {
    left: 24px,
    top: 628px,
    contents: "Harbour at dusk",
    font-size: 24,
    font-style: "SemiBold",
    fill: Tokens.sample.ink
  }

  place = text {
    left: 24px,
    top: 666px,
    contents: "Last light over the slipway",
    font-size: 15,
    fill: Tokens.sample.soft
  }

  counter = text {
    left: 24px,
    top: 780px,
    contents: "3 of 3 · tap the photo",
    font-size: 13,
    fill: Tokens.sample.soft
  }

  closeBtn = frame {
    left: 16px,
    top: 52px,
    width: 40px,
    height: 40px,
    corner-radius: 999px,
    fill: opacity(Tokens.sample.paper, 24%),
    layout: {direction: .row, justify-content: .center, align-items: .center},
    meta: {transition: "instant"},
    connections: {target: ::hub, label: "Close"},
    children: glyph,

    glyph = asset {width: 20px, height: 20px, contents: closeIcon, fill: Tokens.sample.paper}
  }
}
