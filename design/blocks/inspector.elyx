  left: 1280px,
  top: 0px,

  tabs {
    display: .none
  }

  body {
    overrides: [insert(recent, after = .nil)]
  }

  recent = frame : section {
    overrides: [insert(one, after = section.head), insert(two, after = one), insert(three, after = two), insert(four, after = three)],

    head {
      name {
        contents: "Recent files"
      }
    }

    one = frame : Panel.linkPair {
      name {
        contents: "sign-in.elyx"
      }
    }

    two = frame : Panel.linkPair {
      name {
        contents: "button.elyx"
      }
    }

    three = frame : Panel.linkPair {
      name {
        contents: "colors.elyx"
      }
    }

    four = frame : Panel.linkPair {
      name {
        contents: "today.elyx"
      }
    }
  }
}

// The rail for a component: where it lives and where it is used.
export componentRail = frame : rail {
  left: 1600px,
  top: 0px,

  body {
    overrides: [insert(file, after = .nil), insert(variants, after = file), insert(usedBy, after = variants)]
  }

  file = frame : section {
    overrides: [insert(name, after = section.head), insert(place, after = name), insert(code, after = place)],

    head {
      name {
        contents: "Component"
      }
    }

    name = frame : Panel.chipPair {
      key {
        contents: "Name"
      }

      value {
        label {
          contents: "button.elyx"
        }
      }
    }

    place = frame : Panel.pair {
      key {
        contents: "Path"
      }

      value {
        contents: "components/button.elyx"
      }
    }

    code = frame : Panel.pair {
      key {
        contents: "Code"
      }

      value {
        contents: "ui/button.tsx",
        fill[0].color: Colors.colors.accent
      }
    }
  }

  variants = frame : section {
    overrides: [insert(one, after = section.head), insert(two, after = one), insert(three, after = two), insert(four, after = three)],

    head {
      name {
        contents: "Variants"
      }
    }

    one = frame : Panel.chipPair {
      key {
        contents: "primary"
      }

      value {
        label {
          contents: "Base"
        }
      }
    }

    two = frame : Panel.pair {
      key {
        contents: "quiet"
      }

      value {
        contents: "9 uses"
      }
    }

    three = frame : Panel.pair {
      key {
        contents: "outline"
      }

      value {
        contents: "6 uses"
      }
    }

    four = frame : Panel.pair {
      key {
        contents: "danger"
      }

      value {
        contents: "2 uses"
      }
    }
  }

  usedBy = frame : section {
    overrides: [insert(one, after = section.head), insert(two, after = one), insert(three, after = two), insert(four, after = three)],

    head {
      overrides: [insert(all, after = section.head.spacer)],

      name {
        contents: "Used in 4 screens"
      }

      all = asset {
        width: 15px,
        height: 15px,
        contents: gridIcon,
        fill: Colors.colors.muted
      }
    }

    one = frame : Panel.linkPair {
      name {
        contents: "sign-in.elyx"
      }
    }

    two = frame : Panel.linkPair {
      name {
        contents: "landing.elyx"
      }
    }

    three = frame : Panel.linkPair {
      name {
        contents: "pricing.elyx"
      }
    }

    four = frame : Panel.linkPair {
      name {
        contents: "settings.elyx"
      }
    }
  }
}

// The rail for a selected token: its value everywhere, and what follows it.
export tokenRail = frame : rail {
  left: 1920px,
  top: 0px,

  body {
    overrides: [insert(identity, after = .nil), insert(value, after = identity), insert(contexts, after = value), insert(usedBy, after = contexts)]
  }

  identity = frame {
    width: 100%,
    border: {color: Colors.colors.line, width: 1px, sides: .bottom},
    padding: [14px, 4px],
    layout: {direction: .column, item-gap: 10px},
    children: [preview, names],

    preview = frame {
      width: 100%,
      height: 84px,
      corner-radius: Radius.radius.lg,
      fill: #D4633A
    }

    names = frame {
      layout: {direction: .column, item-gap: 1px},
      children: [name, place],

      name = text : Text.heading {
        contents: "colors.clay",
        font-size: 16
      }

      place = text : Text.meta {
        contents: "tokens/colors.elyx"
      }
    }
  }

  value = frame : section {
    overrides: [insert(entry, after = section.head)],

    head {
      name {
        contents: "Value"
      }
    }

    entry = frame : Controls.field {
      width: 100%,

      value {
        contents: "#D4633A"
      }
    }
  }

  contexts = frame : section {
    overrides: [insert(base, after = section.head), insert(darkValue, after = base)],

    head {
      name {
        contents: "Contexts"
      }
    }

    base = frame : Panel.swatchPair {}

    darkValue = frame : Panel.swatchPair {
      swatch {
        fill[0].color: #E8805A
      }

      key {
        contents: "theme=dark"
      }

      value {
        contents: "#E8805A"
      }
    }

  }

  usedBy = frame : section {
    overrides: [insert(one, after = section.head), insert(two, after = one), insert(three, after = two)],

    head {
      name {
        contents: "Used by 34 layers"
      }
    }

    one = frame : Panel.linkPair {
      name {
        contents: "button / primary"
      }
    }

    two = frame : Panel.linkPair {
      name {
        contents: "plan / pro"
      }
    }

    three = frame : Panel.linkPair {
      name {
        contents: "mark / dot"
      }
    }
  }
}

// The Claude tab: bigger requests go to the session that opened the canvas.
export claudeRail = frame : rail {
  left: 2240px,
  top: 0px,

  tabs {
    claude {
      fill: Colors.colors.chip,

      label {
        fill[0].color: Colors.colors.ink
      }
    }

    layer {
      fill: #FFFFFF00,

      label {
        fill[0].color: Colors.colors.muted
      }
    }
  }

  body {
    height: 806px,
    layout: {direction: .column, item-gap: 10px},
    padding: 12px,
    overrides: [insert(space, after = .nil), insert(composer, after = space), insert(note, after = composer)]
  }

  space = frame {}

  composer = frame {
    width: 100%,
    corner-radius: Radius.radius.lg,
    fill: Colors.colors.surface,
    border: {color: Colors.colors.line-strong, width: 1px},
    layout: {direction: .column, item-gap: 8px},
    padding: [12px, 12px, 10px, 12px],
    shadow: {drop-shadow: {color: #0000000A, offset: point(0, 1), blur-radius: 3px}},
    children: [prompt, foot],

    prompt = frame {
      width: 100%,
      height: 56px,
      layout: {direction: .column},
      children: words,

      words = text : Text.body {
        width: 100%,
        contents: "Ask Claude to change something bigger",
        fill: Colors.colors.muted
      }
    }

    foot = frame {
      width: 100%,
      layout: {direction: .row, align-items: .center, item-gap: 6px},
      children: [glyph, about, spacer, send],

      glyph = asset {
        width: 13px,
        height: 13px,
        contents: fileIcon,
        fill: Colors.colors.muted
      }

      about = text : Text.meta {
        contents: "All screens"
      }

      spacer = frame {}

      send = frame {
        width: 28px,
        height: 28px,
        corner-radius: Radius.radius.md,
        fill: Colors.colors.accent,
        layout: {direction: .row, justify-content: .center, align-items: .center},
        children: glyph,

        glyph = asset {
          width: 14px,
          height: 14px,
          contents: arrowIcon,
          fill: Colors.colors.on-accent
        }
      }
    }
  }

  note = text : Text.meta {
    width: 100%,
    contents: "Goes to the Claude session that opened this canvas."
  }
}

// One commit in the History tab: what changed, who, when.
export revisionRow = frame {
  left: 2560px,
  top: 0px,
  width: 256px,
  corner-radius: Radius.radius.md,
  layout: {direction: .row, align-items: .start, item-gap: 10px},
  padding: [8px, 6px],
  children: [mark, names, spacer, hash],

  mark = frame {
    width: 11px,
    height: 18px,
    layout: {direction: .column, justify-content: .center},
    children: dot,

    dot = frame {
      width: 11px,
      height: 11px,
      corner-radius: Radius.radius.full,
      fill: Colors.colors.surface,
      border: {color: Colors.colors.dash, width: 1.5px}
    }
  }

  names = frame {
    layout: {direction: .column, item-gap: 2px},
    children: [subject, detail],

    subject = text : Text.body {
      contents: "Add the welcome flow",
      font-style: "Medium",
      fill: Colors.colors.ink
    }

    detail = text : Text.meta {
      contents: "Mara Oakes, yesterday"
    }
  }

  spacer = frame {}

  hash = text : Text.figure {
    contents: "7d02b18",
    font-size: 11,
    font-style: "Regular",
    fill: Colors.colors.muted
  }
}

// The commit on screen.
@variant
export revisionRowActive = frame : revisionRow {
  left: 2560px,
  top: 80px,
  fill: Colors.colors.chip,

  mark {
    dot {
      fill[0].color: Colors.colors.accent,
      border[0].color: Colors.colors.accent
    }
  }
}

// The History tab: the commits that changed this board, newest first.
export historyRail = frame : rail {
  left: 2880px,
  top: 0px,

  tabs {
    layer {
      fill: #FFFFFF00,

      label {
        fill[0].color: Colors.colors.muted
      }
    }

    history {
      fill: Colors.colors.chip,

      label {
        fill[0].color: Colors.colors.ink
      }
    }
  }

  body {
    overrides: [insert(revisions, after = .nil)]
  }

  revisions = frame : section {
    overrides: [insert(now, after = section.head), insert(quieter, after = now), insert(welcome, after = quieter), insert(signIn, after = welcome), insert(start, after = signIn)],

    head {
      name {
        contents: "Revisions"
      }
    }

    now = frame : revisionRow {
      width: 100%,

      names {
        subject {
          contents: "Now"
        }

        detail {
          contents: "With changes not yet committed"
        }
      }

      hash {
        contents: ""
      }
    }

    quieter = frame : revisionRowActive {
      width: 100%,

      names {
        subject {
          contents: "Quieter pricing cards"
        }

        detail {
          contents: "Mara Oakes, 2 hours ago"
        }
      }

      hash {
        contents: "a1c9e42"
      }
    }

    welcome = frame : revisionRow {
      width: 100%
    }

    signIn = frame : revisionRow {
      width: 100%,

      names {
        subject {
          contents: "Draw the sign-in screen"
        }

        detail {
          contents: "Sam Lee, 3 days ago"
        }
      }

      hash {
        contents: "3f6e0aa"
      }
    }

    start = frame : revisionRow {
      width: 100%,

      names {
        subject {
          contents: "Start Driftwood"
        }

        detail {
          contents: "Sam Lee, last week"
        }
      }

      hash {
        contents: "0b51c7d"
      }
    }
  }
}
