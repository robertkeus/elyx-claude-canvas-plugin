// The tokens view: groups previewed by their colors, then the scales and contexts.
export tokensSidebar = frame : sidebar {
  left: 960px,
  top: 0px,

  body {
    overrides: [insert(colorsAll, after = .nil), insert(colorsHead, after = colorsAll), insert(surfaces, after = colorsHead), insert(words, after = surfaces), insert(status, after = words), insert(scaleHead, after = status), insert(spacing, after = scaleHead), insert(sizes, after = spacing), insert(radius, after = sizes), insert(fontSizes, after = radius), insert(tracking, after = fontSizes), insert(contextHead, after = tracking), insert(base, after = contextHead), insert(dark, after = base)]
