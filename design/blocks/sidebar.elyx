import "sample/images/landing.png" as landingShot
import "sample/images/pricing.png" as pricingShot
import "sample/images/signIn.png" as signInShot
import "sample/images/welcome.png" as welcomeShot
import "sample/images/today.png" as todayShot
import "sample/images/notes.png" as notesShot
import "sample/images/note.png" as noteShot
import "sample/images/settings.png" as settingsShot
import "icons/frame.svg" as frameIcon
import "icons/component.svg" as componentIcon
import "icons/palette.svg" as paletteIcon
import "icons/image.svg" as imageIcon
import "icons/search.svg" as searchIcon
import "icons/history.svg" as historyIcon
import "icons/grid.svg" as gridIcon
import "icons/layers.svg" as layersIcon
import "icons/type.svg" as typeIcon
import "icons/corner.svg" as cornerIcon
import "icons/gap.svg" as gapIcon
import "tokens/colors.elyx" as Colors
import "tokens/radius.elyx" as Radius
import "tokens/spacing.elyx" as Spacing
import "components/controls.elyx" as Controls
import "components/nav.elyx" as Nav
import "components/type.elyx" as Text

// Search, the four views of a project, and a body per view.
export sidebar = frame {
  left: 0px,
  top: 0px,
  width: Spacing.size.sidebar,
  height: 100%,
  fill: Colors.colors.surface,
  border: {color: Colors.colors.line, width: 1px, sides: .right},
  layout: {direction: .column},
  children: [head, tabs, body],

  head = frame {
    width: 100%,
    height: Spacing.size.top-bar,
    layout: {direction: .row, align-items: .center, item-gap: 8px},
    padding: [0px, 12px],
    children: [find, recent],

    find = frame : Controls.field {
      width: 208px,
      overrides: [insert(glyph, after = .nil), insert(spacer, after = Controls.field.value), insert(keys, after = spacer)],

      value {
        contents: "Search",
        fill[0].color: Colors.colors.muted
      }

      glyph = asset {
        width: 14px,
        height: 14px,
        contents: searchIcon,
        fill: Colors.colors.muted
      }

      spacer = frame {}

      keys = frame : Controls.keycap {}
    }

    recent = frame : Controls.iconButtonSoft {
      glyph {
        contents: historyIcon
      }
    }
  }

  tabs = frame {
    width: 100%,
    height: Spacing.size.tab-bar,
    border: {color: Colors.colors.line, width: 1px, sides: [.top, .bottom]},
    layout: {direction: .row, align-items: .center},
    children: [screens, dividerOne, parts, dividerTwo, tokens, dividerThree, assets],

    screens = frame : Nav.tab {
      glyph {
        contents: frameIcon
      }
    }

    dividerOne = frame : Nav.tabDivider {}

    parts = frame : Nav.tab {
      glyph {
        contents: componentIcon
      }
    }

    dividerTwo = frame : Nav.tabDivider {}

    tokens = frame : Nav.tab {
      glyph {
        contents: paletteIcon
      }
    }

    dividerThree = frame : Nav.tabDivider {}

    assets = frame : Nav.tab {
      glyph {
        contents: imageIcon
      }
    }
  }

  body = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 2px},
    padding: [10px, 12px],
    slot: .true
  }
}

// The screens view. Rows carry thumbnails, so a screen is found by sight.
export screensSidebar = frame : sidebar {
  left: 320px,
  top: 0px,

  body {
    overrides: [insert(all, after = .nil), insert(siteHead, after = all), insert(landing, after = siteHead), insert(pricing, after = landing), insert(accessHead, after = pricing), insert(signIn, after = accessHead), insert(welcome, after = signIn), insert(appHead, after = welcome), insert(today, after = appHead), insert(notes, after = today), insert(note, after = notes), insert(settings, after = note)]
  }

  tabs {
    screens {
      glyph {
        fill[0].color: Colors.colors.accent
      }
    }
  }

  all = frame : Nav.pillRow {
    glyph {
      contents: gridIcon
    }

    label {
      contents: "All screens"
    }

    count {
      contents: "8"
    }
  }

  siteHead = frame : Nav.navHead {
    label {
      contents: "Site"
    }

    count {
      contents: "2"
    }
  }

  landing = frame : Nav.thumbRow {
    shot {
      fill: {image: {ref: landingShot}}
    }

    label {
      contents: "Landing"
    }
  }

  pricing = frame : Nav.thumbRow {
    shot {
      fill: {image: {ref: pricingShot}}
    }

    label {
      contents: "Pricing"
    }
  }

  accessHead = frame : Nav.navHead {
    label {
      contents: "Access"
    }

    count {
      contents: "2"
    }
  }

  signIn = frame : Nav.thumbRow {
    shot {
      fill: {image: {ref: signInShot}}
    }

    label {
      contents: "Sign in"
    }
  }

  welcome = frame : Nav.thumbRow {
    shot {
      fill: {image: {ref: welcomeShot}}
    }

    label {
      contents: "Welcome"
    }
  }

  appHead = frame : Nav.navHead {
    label {
      contents: "App"
    }

    count {
      contents: "4"
    }
  }

  today = frame : Nav.thumbRow {
    shot {
      fill: {image: {ref: todayShot}}
    }

    label {
      contents: "Today"
    }
  }

  notes = frame : Nav.thumbRow {
    shot {
      fill: {image: {ref: notesShot}}
    }

    label {
      contents: "Notes"
    }
  }

  note = frame : Nav.thumbRow {
    shot {
      fill: {image: {ref: noteShot}}
    }

    label {
      contents: "Note"
    }
  }

  settings = frame : Nav.thumbRow {
    shot {
      fill: {image: {ref: settingsShot}}
    }

    label {
      contents: "Settings"
    }
  }
}

