import "icons/house.svg" as homeIcon
import "icons/chevron-left.svg" as backIcon
import "icons/chevron-right.svg" as forwardIcon
import "icons/chevron-down.svg" as chevronIcon
import "icons/columns.svg" as panelIcon
import "icons/pointer.svg" as pointerIcon
import "icons/eye.svg" as eyeIcon
import "icons/moon.svg" as moonIcon
import "icons/sparkles.svg" as sparkIcon
import "tokens/colors.elyx" as Colors
import "tokens/radius.elyx" as Radius
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Type
import "components/controls.elyx" as Controls
import "components/type.elyx" as Text

// The round Ask Claude button, in the corner where the editor keeps its assistant.
export orb = frame {
  left: 1000px,
  top: 0px,
  width: 36px,
  height: 36px,
  corner-radius: Radius.radius.full,
  fill: {linear-gradient: {angle: 135deg, stops: [stop(0%, Colors.colors.orb-start), stop(100%, Colors.colors.orb-end)]}},
  border: {color: Colors.colors.surface, width: 2px},
  layout: {direction: .row, justify-content: .center, align-items: .center},
  shadow: {drop-shadow: {color: #6C5CE733, offset: point(0, 4), blur-radius: 12px}},
  children: glyph,

  glyph = asset {
    width: 16px,
    height: 16px,
    contents: sparkIcon,
    fill: #FFFFFF
  }
}

// Everything between the sidebar and the inspector. Insert content into `stage`.
export center = frame {
  left: 0px,
  top: 0px,
  width: Spacing.size.center,
  height: 100%,
  layout: {direction: .column},
  fill: Colors.colors.surface,
  children: [topBar, stage],

  // The page and its branch in the middle, the way back on the left, the panels at the ends.
  topBar = frame {
    width: 100%,
    height: Spacing.size.top-bar,
    border: {color: Colors.colors.line, width: 1px, sides: .bottom},
    layout: {direction: .row, align-items: .center, item-gap: 2px},
    padding: [0px, 10px],
    children: [title, side, home, back, forward, spacer, rail],

    title = frame {
      ignore-stack: .true,
      left: 0px,
      top: 0px,
      width: Spacing.size.center,
      height: Spacing.size.top-bar,
      layout: {direction: .row, justify-content: .center, align-items: .center, item-gap: 8px},
      children: [page, branch],

      page = text : Text.body {
        contents: "All screens",
        font-style: "Medium",
        fill: Colors.colors.ink
      }

      branch = frame {
        height: 20px,
        corner-radius: Radius.radius.xs,
        fill: Colors.colors.chip,
        layout: {direction: .row, align-items: .center},
        padding: [0px, 6px],
        children: label,

        label = text : Text.figure {
          contents: "main",
          font-size: Type.fontSize.xs,
          font-style: "Regular",
          fill: Colors.colors.body
        }
      }
    }

    side = frame : Controls.iconButton {
      glyph {
        contents: panelIcon,
        transform: [-1, 0, 16, 0, 1, 0]
      }
    }

    home = frame : Controls.iconButton {
      glyph {
        contents: homeIcon
      }
    }

    back = frame : Controls.iconButton {
      glyph {
        contents: backIcon
      }
    }

    forward = frame : Controls.iconButton {
      glyph {
        contents: forwardIcon,
        fill[0].color: Colors.colors.faint
      }
    }

    spacer = frame {}

    rail = frame : Controls.iconButton {
      glyph {
        contents: panelIcon
      }
    }
  }

  stage = frame {
    width: 100%,
    height: Spacing.size.stage-height,
    fill: Colors.colors.stage,
    border: {color: Colors.colors.line, width: 1px, sides: [.left, .right]},
    slot: .true,
    children: hud,

    // The one floating bar: how the board is drawn, the zoom, and Claude.
    hud = frame {
      left: 282px,
      bottom: 20px,
      width: 324px,
      height: 44px,
      corner-radius: Radius.radius.lg,
      fill: Colors.colors.surface,
      border: {color: Colors.colors.line-strong, width: 1px},
      layout: {direction: .row, justify-content: .center, align-items: .center, item-gap: 2px},
      padding: 5px,
      shadow: [{drop-shadow: {color: #00000014, offset: point(0, 8), blur-radius: 24px}}, {drop-shadow: {color: #0000000F, offset: point(0, 1), blur-radius: 3px}}],
      children: [inspect, overlays, theme, rule, level, count, context, pad, claude],

      inspect = frame : Controls.iconButtonActive {
        glyph {
          contents: pointerIcon
        }
      }

      overlays = frame : Controls.iconButton {
        glyph {
          contents: eyeIcon
        }
      }

      theme = frame : Controls.iconButton {
        glyph {
          contents: moonIcon
        }
      }

      rule = frame : Controls.divider {}

      level = frame {
        width: 72px,
        height: 32px,
        corner-radius: Radius.radius.md,
        fill: Colors.colors.chip,
        layout: {direction: .row, justify-content: .center, align-items: .center, item-gap: 6px},
        children: [label, chevron],

        label = text : Text.figure {
          contents: "100%"
        }

        chevron = asset {
          width: 12px,
          height: 12px,
          contents: chevronIcon,
          fill: Colors.colors.muted
        }
      }

      // Kept for the screens that still name them; the panels say this now.
      count = frame : Controls.stageChip {
        display: .none
      }

      context = frame : Controls.stageChip {
        display: .none
      }

      pad = frame {
        width: 4px,
        height: 1px
      }

      claude = frame {
        width: 112px,
        height: 32px,
        corner-radius: Radius.radius.md,
        fill: Colors.colors.accent-soft,
        layout: {direction: .row, justify-content: .center, align-items: .center, item-gap: 6px},
        children: [glyph, label],

        glyph = asset {
          width: 14px,
          height: 14px,
          contents: sparkIcon,
          fill: Colors.colors.accent
        }

        label = text : Text.label {
          contents: "Ask Claude",
          font-style: "Medium",
          fill: Colors.colors.accent
        }
      }
    }
  }
}
