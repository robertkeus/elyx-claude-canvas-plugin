import "components/controls.elyx" as Controls
import "components/type.elyx" as Text

export componentDetail = frame {
  title: "Component",
  caption: "One component and its variants, with where it is used highlighted in place.",
  left: 0px,
  top: 0px,
  width: Spacing.size.screen,
  height: Spacing.size.screen-height,
  fill: Colors.colors.surface,
  layout: {direction: .row},
  children: [side, main, rail],

  side = frame : Sidebar.partsSidebar {
    body {
      button {
        fill: Colors.colors.chip,

        glyph {
          fill[0].color: Colors.colors.ink
        }

        label {
          font-style: "Medium",
          fill[0].color: Colors.colors.ink
        }

        count {
          fill[0].color: Colors.colors.muted
        }
      }
    }
  }

  main = frame : Center.center {
    stage {
      overrides: [insert(world, after = .nil)],

      hud {
        count {
          label {
            contents: "4 Variants"
          }

          key {
            letter {
              contents: "V"
            }
          }
        }
      }
    }

    topBar {
      title {
        page {
          contents: "button"
        }
      }
    }

    world = frame {
      left: 0px,
      top: 0px,
      width: 100%,
      height: 100%,
      children: [head, primaryItem, quietItem, outlineItem, dangerItem, used],

      head = frame {
        left: 48px,
        top: 40px,
        layout: {direction: .column, item-gap: 4px},
        children: [name, note],

        name = text : Text.pageTitle {
          contents: "Button"
        }

        note = text : Text.body {
          contents: "4 variants, used in 4 screens",
          fill: Colors.colors.muted
        }
      }

      primaryItem = frame {
        left: 48px,
        top: 118px,
        width: 186px,
        height: 96px,
        overflow: .visible,
        children: [title, art],

        title = frame : Canvas.artboardTitle {
          left: 0px,
          top: 0px,

          name {
            contents: "primary"
          }
        }

        art = frame : Sample.button {
          left: 0px,
          top: 28px,
          transform: [1.5, 0, 0, 0, 1.5, 0]
        }
      }

      quietItem = frame {
        left: 248px,
        top: 118px,
        width: 186px,
        height: 96px,
        overflow: .visible,
        children: [title, art],

        title = frame : Canvas.artboardTitle {
          left: 0px,
          top: 0px,

          name {
            contents: "quiet"
          }
        }

        art = frame : Sample.buttonQuiet {
          left: 0px,
          top: 28px,
          transform: [1.5, 0, 0, 0, 1.5, 0]
        }
      }

      outlineItem = frame {
        left: 448px,
        top: 118px,
        width: 186px,
        height: 96px,
        overflow: .visible,
        children: [title, art],

        title = frame : Canvas.artboardTitle {
          left: 0px,
          top: 0px,

          name {
            contents: "outline"
          }
        }

        art = frame : Sample.buttonOutline {
          left: 0px,
          top: 28px,
          transform: [1.5, 0, 0, 0, 1.5, 0]
        }
      }

      dangerItem = frame {
        left: 648px,
        top: 118px,
        width: 186px,
        height: 96px,
        overflow: .visible,
        children: [title, art],

        title = frame : Canvas.artboardTitle {
          left: 0px,
          top: 0px,

          name {
            contents: "danger"
          }
        }

        art = frame : Sample.buttonDanger {
          left: 0px,
          top: 28px,
          transform: [1.5, 0, 0, 0, 1.5, 0]
        }
      }

      used = frame {
        left: 48px,
        top: 250px,
        width: Spacing.size.page-width,
        layout: {direction: .column, item-gap: 14px},
        children: [title, row],

        title = text : Text.heading {
          contents: "Where it is used"
        }

        row = frame {
          width: 100%,
          layout: {direction: .row, item-gap: 16px},
          children: [landingUse, pricingUse, signInUse],

        landingUse = frame {
          layout: {direction: .column, item-gap: 6px},
          children: [frameShot, name],

          frameShot = frame {
            width: 240px,
            height: 154px,
            corner-radius: Radius.radius.md,
            fill: {image: {ref: landingShot}},
            border: {color: Colors.colors.line-strong, width: 1px},
            children: mark,

            mark = frame {
              left: 12.6px,
              top: 108.0px,
              width: 68.0px,
              height: 19.4px,
              corner-radius: 2px,
              border: {color: Colors.colors.accent, width: 1.5px, position: .outside}
            }
          }

          name = text : Text.meta {
            contents: "landing"
          }
        }

        pricingUse = frame {
          layout: {direction: .column, item-gap: 6px},
          children: [frameShot, name],

          frameShot = frame {
            width: 240px,
            height: 154px,
            corner-radius: Radius.radius.md,
            fill: {image: {ref: pricingShot}},
            border: {color: Colors.colors.line-strong, width: 1px},
            children: mark,

            mark = frame {
              left: 92.6px,
              top: 107.4px,
              width: 53.7px,
              height: 17.1px,
              corner-radius: 2px,
              border: {color: Colors.colors.accent, width: 1.5px, position: .outside}
            }
          }

          name = text : Text.meta {
            contents: "pricing"
          }
        }

        signInUse = frame {
          layout: {direction: .column, item-gap: 6px},
          children: [frameShot, name],

          frameShot = frame {
            width: 240px,
            height: 154px,
            corner-radius: Radius.radius.md,
            fill: {image: {ref: signInShot}},
            border: {color: Colors.colors.line-strong, width: 1px},
            children: mark,

            mark = frame {
              left: 61.7px,
              top: 96.3px,
              width: 116.6px,
              height: 19.4px,
              corner-radius: 2px,
              border: {color: Colors.colors.accent, width: 1.5px, position: .outside}
            }
          }

          name = text : Text.meta {
            contents: "sign-in"
          }
        }
        }
      }
    }
  }

  rail = frame : Inspector.componentRail {}
}
