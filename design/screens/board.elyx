        }
      }

      note = frame : Canvas.artboard {
        left: 454px,
        top: 250px,
        width: 190px,

        title {
          name {
            contents: "note"
          }
        }

        shot {
          height: 122px,
          fill: {image: {ref: noteShot}}
        }
      }

      settings = frame : Canvas.artboard {
        left: 666px,
        top: 250px,
        width: 190px,

        title {
          name {
            contents: "settings"
          }
        }

        shot {
          height: 122px,
          fill: {image: {ref: settingsShot}}
        }
      }

      plansFlowLine = frame : Canvas.flowLine {
