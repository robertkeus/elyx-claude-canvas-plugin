      landing = frame : Canvas.artboard {
        left: 30px,
        top: 60px,
        width: 190px,

        title {
          name {
            contents: "landing"
          }
        }

        shot {
          height: 122px,
          fill: {image: {ref: landingShot}}
        }
      }

      pricing = frame : Canvas.artboard {
