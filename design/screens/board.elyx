        top: 60px,
        width: 190px,

        title {
          name {
            contents: "welcome"
          }
        }

        shot {
          height: 122px,
          fill: {image: {ref: welcomeShot}}
        }
      }

      today = frame : Canvas.artboard {
        left: 30px,
        top: 250px,
        width: 190px,

        title {
          name {
            contents: "today"
          }
        }

        shot {
          height: 122px,
          fill: {image: {ref: todayShot}}
        }
      }

      notes = frame : Canvas.artboard {
        left: 242px,
        top: 250px,
        width: 190px,

