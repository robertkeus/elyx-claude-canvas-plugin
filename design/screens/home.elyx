import "sample/images/landing.png" as landingCardShot
import "sample/images/pricing.png" as pricingCardShot
import "sample/images/welcome.png" as welcomeCardShot
import "sample/images/signIn.png" as signInCardShot
import "sample/images/today.png" as todayCardShot
import "sample/images/notes.png" as notesCardShot
import "icons/chevron-down.svg" as chevronIcon
import "tokens/colors.elyx" as Colors
import "tokens/spacing.elyx" as Spacing
import "blocks/center.elyx" as Center
import "blocks/inspector.elyx" as Inspector
import "blocks/sidebar.elyx" as Sidebar
import "components/card.elyx" as Card
import "components/controls.elyx" as Controls
import "components/type.elyx" as Text

export home = frame {
  title: "Home",
  caption: "The first thing you see: every file in the design as a preview, the newest first.",
  left: 0px,
  top: 0px,
  width: Spacing.size.screen,
  height: Spacing.size.screen-height,
  fill: Colors.colors.surface,
  layout: {direction: .row},
  children: [side, main, rail],

  side = frame : Sidebar.screensSidebar {}

  main = frame : Center.center {
    stage {
      fill: Colors.colors.surface,
      overrides: [insert(page, after = .nil)],

      hud {
        display: .none
      }
    }

    topBar {
      title {
        page {
          contents: "Home"
        }
      }
    }

    page = frame {
      left: 48px,
      top: 40px,
      width: Spacing.size.page-width,
      layout: {direction: .column, item-gap: 16px},
      children: [head, filters, rule, grid],

      head = frame {
        width: 100%,
        layout: {direction: .row, align-items: .center, item-gap: 12px},
        children: [names, spacer, sort],

        names = frame {
          layout: {direction: .column, item-gap: 4px},
          children: [name, note],

          name = text : Text.pageTitle {
            contents: "Driftwood"
          }

          note = text : Text.body {
            contents: "8 screens, 16 components, 46 tokens and 33 assets",
            fill: Colors.colors.muted
          }
        }

        spacer = frame {}

        sort = frame : Controls.button {
          overrides: [insert(chevron, after = Controls.button.label)],

          label {
            contents: "Last changed"
          }

          chevron = asset {
            width: 12px,
            height: 12px,
            contents: chevronIcon,
            fill: Colors.colors.muted
          }
        }
      }

      filters = frame {
        width: 100%,
        layout: {direction: .row, align-items: .center, item-gap: 4px},
        children: [all, screens, parts, tokens, assets],

        all = frame : Controls.filterActive {
          label {
            contents: "All"
          }
        }

        screens = frame : Controls.filter {
          label {
            contents: "Screens"
          }
        }

        parts = frame : Controls.filter {
          label {
            contents: "Components"
          }
        }

        tokens = frame : Controls.filter {
          label {
            contents: "Tokens"
          }
        }

        assets = frame : Controls.filter {
          label {
            contents: "Assets"
          }
        }
      }

      rule = frame {
        width: 100%,
        height: 1px,
        fill: Colors.colors.line-strong
      }

      grid = frame {
        width: 100%,
        layout: {direction: .row, wrap: .true, item-gap: 24px, line-gap: 32px},
        children: [landingCard, pricingCard, welcomeCard, signInCard, todayCard, notesCard],

        landingCard = frame : Card.fileCard {
          shot {
            fill: {image: {ref: landingCardShot}}
          }

          caption {
            names {
              name {
                contents: "landing.elyx"
              }

              detail {
                contents: "Changed 2h ago"
              }
            }

            badge {
              label {
                contents: "Updated"
              }
            }
          }
        }

        pricingCard = frame : Card.fileCard {
          shot {
            fill: {image: {ref: pricingCardShot}}
          }

          caption {
            names {
              name {
                contents: "pricing.elyx"
              }

              detail {
                contents: "Changed 2h ago"
              }
            }

            badge {
              label {
                contents: "New"
              }
            }
          }
        }

        welcomeCard = frame : Card.fileCard {
          shot {
            fill: {image: {ref: welcomeCardShot}}
          }

          caption {
            names {
              name {
                contents: "welcome.elyx"
              }

              detail {
                contents: "Changed 2h ago"
              }
            }

            badge {
              label {
                contents: "New"
              }
            }
          }
        }

        signInCard = frame : Card.fileCard {
          shot {
            fill: {image: {ref: signInCardShot}}
          }

          caption {
            names {
              name {
                contents: "sign-in.elyx"
              }

              detail {
                contents: "Changed yesterday"
              }
            }

            badge {
              label {
                contents: "Updated"
              }
            }
          }
        }

        todayCard = frame : Card.fileCard {
          shot {
            fill: {image: {ref: todayCardShot}}
          }

          caption {
            names {
              name {
                contents: "today.elyx"
              }

              detail {
                contents: "Changed 3 days ago"
              }
            }

            badge {
              display: .none
            }
          }
        }

        notesCard = frame : Card.fileCard {
          shot {
            fill: {image: {ref: notesCardShot}}
          }

          caption {
            names {
              name {
                contents: "notes.elyx"
              }

              detail {
                contents: "Changed last week"
              }
            }

            badge {
              display: .none
            }
          }
        }
      }
    }
  }

  rail = frame : Inspector.recentRail {}
}
